{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuefchen.github.io/Wonderland_Plugin_Catalog/catalog/v1/index.schema.json",
  "title": "Wonderland Assistant Plugin Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "versionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minVersion", "maxVersionExclusive"],
      "properties": {
        "minVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "maxVersionExclusive": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "hostCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minCoreVersion", "maxCoreVersionExclusive", "protocol"],
      "properties": {
        "minCoreVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "maxCoreVersionExclusive": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol": { "$ref": "#/$defs/versionRange" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "abi"],
      "properties": {
        "os": { "const": "windows" },
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "abi": { "const": "msvc" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "author", "repositoryUrl", "version",
        "downloadUrl", "sha256", "sizeBytes", "hostCompatibility", "uiBridgeCompatibility", "platform", "capabilities"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
        "releaseNotesUrl": { "type": ["string", "null"], "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "hostCompatibility": { "$ref": "#/$defs/hostCompatibility" },
        "uiBridgeCompatibility": {
          "oneOf": [
            { "$ref": "#/$defs/versionRange" },
            { "type": "null" }
          ]
        },
        "platform": { "$ref": "#/$defs/platform" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
